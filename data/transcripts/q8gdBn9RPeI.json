      "text": "اب ہید کی پوضیشن سے یہ ایک بڈال نہیں ہے"
    },
    {
      "id": 128,
      "start": 4022.4,
      "end": 4024.4,
      "text": "تو یہ ترٹ چٹپ"
    },
    {
      "id": 129,
      "start": 4025.4,
      "end": 4027.4,
      "text": "تو یہ ایاد کیا"
    },
    {
      "id": 130,
      "start": 4168.27,
      "end": 4169.27,
      "text": "ھا کیا معرفتا ہے ھتا کیوں؟"
    },
    {
      "id": 131,
      "start": 4169.77,
      "end": 4173.57,
      "text": "ھو با کر مو اس تمہجنا ہیں انسرٹ اٹٹٹیل کے بارے میں تو یہ گیم خدا سانے ہا ہے"
    },
    {
      "id": 132,
      "start": 4173.77,
      "end": 4176.27,
      "text": "انسریٹٹ ٹیل کی باریں میں سبو اگنا وہ بہتا سانگیم ہے"
    },
    {
      "id": 133,
      "start": 4176.57,
      "end": 4179.47,
      "text": "اگر میں دوارہ جا کہ پیچھے درفوں کا سنگری لیکنش میں کیسے کیا تھا"
    },
    {
      "id": 134,
      "start": 4179.67,
      "end": 4180.87,
      "text": "تو ایک نورڈ بنائی تھی"
    },
    {
      "id": 135,
      "start": 4181.07,
      "end": 4183.37,
      "text": "فر لاش نورٹ کوم میں νیوال نورد پونٹ کر بہا ہے"
    },
    {
      "id": 136,
      "start": 4183.47,
      "end": 4184.77,
      "text": "و فیٹٹھیل کو آبڑٹ کر دیا تھا"
    },
    {
      "id": 137,
      "start": 4184.87,
      "end": 4185.77,
      "text": "تین چیزا ہم نے گی دی تی"
    },
    {
      "id": 138,
      "start": 4347.68,
      "end": 4351.22,
      "text": "اسیدہ کول لیکن وہ تاپوات کرنفیز ہوگے اسلام آپ ایک سمدازم با کر لیکھن با کہ آپ کو سمجھ ماذا ہے"
    },
    {
      "id": 139,
      "start": 4351.72,
      "end": 4353.86,
      "text": "تو اس پکر میں نے کر دیا تو ابھی تک میری لنگلیست ہے"
    },
    {
      "id": 140,
      "start": 4353.96,
      "end": 4355.62,
