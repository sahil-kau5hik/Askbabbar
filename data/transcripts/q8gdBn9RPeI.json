      "end": 4490.44,
      "text": "ہم آگے بڑھتی جا رہے ہیں"
    },
    {
      "id": 158,
      "start": 4491.44,
      "end": 4492.44,
      "text": "جس پوڈیشن میں میں انسٹ کرنا ہاں ہا تھا کہ بژھتи جاں"
    },
    {
      "id": 159,
      "start": 4493.44,
      "end": 4494.44,
