    {
      "id": 58,
      "start": 479.73,
      "end": 488.79,
      "text": "ایپاہلی ایدوٹ لنس کے ایک لوگے ان شوٹ آپ کی ورٹ اوٹ اون کی لنط چھوٹی تی ورڈ اون سے اس کس میں کرنا ہے اس کئیس ہم پوز سمپلانس رہا ہے"
    },
    {
      "id": 59,
      "start": 489.79,
      "end": 492.79,
      "text": "جانس دیکھو ہمیں یہ والے 2 קریکٹر تی جو کی بیسگلیں سرٹ کرنے سے آہنگیں"
    },
    {
      "id": 60,
      "start": 557.72,
      "end": 560.72,
      "text": "ھاں ہوں گے ھو بھی میں نے انڈ ملگا ہے اس پکار سال کرنے نکل پڑا ہوںگے"
    },
    {
      "id": 61,
      "start": 562.14,
      "end": 564.14,
      "text": "اگر اس پیکار سول کر ہو گے آپ کا بیس کے سہ سبہ نگے"
    },
    {
      "id": 62,
      "start": 565.14,
      "end": 567.14,
      "text": "تو ریٹان ایس کی جگ آپ کہ آپ کہیں سمپل جی آژے گا"
    },
    {
      "id": 63,
      "start": 568.78,
      "end": 570.78,
      "text": "ریطان جی"
    },
    {
      "id": 64,
      "start": 571.78,
      "end": 573.78,
      "text": "لیکن ہوں نے یہ جو رکھوں میں ہوں کہ ہوں میں اسے ریگے سال کامے والے"
    },
    {
      "id": 65,
      "start": 574.9,
      "end": 576.9,
      "text": "تو چاہوں دون تریگے صال کریں تو تمہاری مرزگی"
    },
    {
      "id": 66,
      "start": 577.9,
      "end": 580.9,
      "text": "انشور میں ہی یہ کہنا چا تھا ہونے کہ جب تمہرا آئی پہلے"
    },
    {
      "id": 67,
      "start": 581.9,
      "end": 582.9,
      "text": "ایڈ اٹلانت کے ایکل ہو جائے"
    },
    {
      "id": 68,
      "start": 682.78,
      "end": 686.88,
      "text": "तो लेगा मिला की मैंने हम पर नस्तकर दिया है"
    },
    {
      "id": 69,
      "start": 687.38,
      "end": 689.18,
      "text": "मैने यहां प्र रह न सरत कर और लिय है"
    },
    {
      "id": 70,
      "start": 689.44,
      "end": 691.98,
      "text": "तo विश्रत आणी बिले ज़ी है"
    },
    {
      "id": 71,
      "start": 692.24,
      "end": 695.28,
      "text": "भूर फर टे नسरतक औ लीया थो इन्स्चर खे पार धर तर बाई नहाँ"
    },
