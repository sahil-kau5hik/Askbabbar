    {
      "id": 16,
      "start": 224.06,
      "end": 227.56,
      "text": "ھاں پر آپ بہت پکار کی کورسیز دیستکنگر آپ انٹرشڈ ہے پیڑ کورсیز کے اندر آپ چاہتے گے"
    },
    {
      "id": 17,
      "start": 227.66,
      "end": 229.42,
      "text": "تیولیمٹ کرلو ایر مشیل لیرنگ کرلوں"
    },
    {
      "id": 18,
      "start": 229.52,
      "end": 231.52,
      "text": "اینڈڈ کرلیں گے تیزڈگ کر لوں"
    },
    {
      "id": 19,
      "start": 231.82,
      "end": 233.68,
      "text": "کور سبتے او از ریبیمس وگر اپڑڑھا پڑے لوں"
    },
    {
      "id": 20,
      "start": 233.86,
      "end": 236.66,
      "text": "میں یا دیسے کرلے جا وہ پائیتن کسی بھی لانگوچ کی اندר"
    },
    {
      "id": 21,
      "start": 236.8,
      "end": 238.42,
      "text": "تو آپ یہاں سے وہ پیٹ کور اسے لے پائیں گیں"
    },
    {
      "id": 22,
      "start": 238.52,
      "end": 239.72,
      "text": "سب سے پیاری چیز جو لوگ"
    },
    {
      "id": 23,
      "start": 239.72,
      "end": 240.72,
      "text": "ھاکھے پڑھے گھے۔"
    },
    {
      "id": 24,
      "start": 241.72,
      "end": 242.72,
      "text": "ھتے ہیں۔"
    },
    {
      "id": 25,
      "start": 243.72,
      "end": 244.72,
      "text": "ھیں گے۔"
    },
    {
