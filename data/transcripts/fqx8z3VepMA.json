    },
    {
      "id": 37,
      "start": 359.0,
      "end": 361.0,
      "text": "ھاں سے شوڑ کر گے, ھتے ہیں"
    },
    {
      "id": 38,
      "start": 362.0,
      "end": 367.22,
      "text": "یہ پیڑی بروچ ہو گیا, اب بعد کرتے اپٹی مائز اپروج کے بارے میں"
    },
    {
      "id": 39,
      "start": 368.22,
      "end": 371.2,
      "text": "اب دھا ہوں, اب دہا ہیں"
    },
    {
      "id": 40,
      "start": 372.2,
      "end": 373.56,
      "text": "بہت پیری چی ہے"
    },
    {
      "id": 41,
      "start": 374.56,
      "end": 375.56,
      "text": "بہا دہ سان چیز ہے"
    },
    {
      "id": 42,
      "start": 376.56,
      "end": 377.56,
      "text": "مزا آ جہے گا"
    },
    {
      "id": 43,
      "start": 378.56,
      "end": 380.56,
      "text": "اگر آپ ذہن سے دھے تو اپنا پیر آپ کیا گلتی کر رہے"
    },
    {
      "id": 44,
      "start": 381.56,
      "end": 383.56,
      "text": "اب اس بیسٹیگال فنکشن ہر کسی کے لیکن کل کریں"
    },
    {
      "id": 45,
      "start": 384.56,
      "end": 385.56,
      "text": "اپنی اپریشن تھا تب کا ٹیمگرشری انس کر ہو گئی"
    },
    {
      "id": 46,
      "start": 890.77,
      "end": 901.38,
      "text": "ھا چیشے ہیں جی آپ کا میکسی آپکہ میری آپ کا بول اس بیستی اور آپ کا"
    },
    {
