    },
    {
      "id": 48,
      "start": 1093.62,
      "end": 1094.62,
      "text": "وہ اس پر کار پر انٹ کر رہا ہے"
    },
    {
      "id": 49,
      "start": 1096.52,
      "end": 1098.52,
      "text": "تو ليفنت پر نک کر را رہے ہا وہ لفتوڑ رائٹ کی تریکشن میں"
    },
    {
      "id": 50,
