    {
      "id": 41,
      "start": 814.22,
      "end": 817.25,
      "text": "ایک 520 واؤ تو یہ 520 تسیکہ اسمارے پاس ہو گئیں"
    },
    {
      "id": 42,
      "start": 818.25,
      "end": 821.25,
      "text": "اس پکار ہم نے اپنا سلیشن ختم کر بھی اور ہم کیا سمجھ ماغے گا بھی اپورت ہم کر لیں"
    },
    {
      "id": 43,
      "start": 822.25,
      "end": 824.25,
      "text": "جیکز ایک ٹرورٹ سے ناہا ہمیں کرنا آگے ہم میں کہا بہلا دوارہ دیکھیں"
    },
    {
      "id": 44,
      "start": 825.25,
      "end": 827.25,
      "text": "ایک کیوں بناتے ہیں اس میں روٹنٹ ہم ندالا"
    },
    {
      "id": 45,
      "start": 828.25,
