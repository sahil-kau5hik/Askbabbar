      "start": 3847.46,
      "end": 3849.91,
      "text": "کیا سے پتلگے گئا"
    },
    {
      "id": 133,
      "start": 3880.39,
      "end": 3884.49,
      "text": "و بھالے بہت اصانع یہ پتلاگا نہ کہ تم کبھ نکس لیوال پر محاجے"
    },
    {
      "id": 134,
      "start": 3885.14,
      "end": 3887.14,
      "text": "تم کبر نکش لیول پر پہنچے"
    },
    {
      "id": 135,
      "start": 3888.04,
      "end": 3890.86,
      "text": "تو اس کو اگر سمجھ کوئی اش کرتے ہیں"
    },
    {
      "id": 136,
      "start": 3891.06,
      "end": 3893.06,
      "text": "میں نے کہ بلکہ میرا فنگشن کیس پر گار کا ہوگا"
    },
    {
      "id": 137,
      "start": 3893.26,
      "end": 3895.36,
      "text": "جب ایساول کرنے دارا ہوں اس کے اندار چیز ہوں گی"
    },
    {
      "id": 138,
      "start": 3895.56,
      "end": 3896.5,
      "text": "اس کےндار دار چینز ہون گی"
    },
    {
      "id": 139,
      "start": 3896.66,
      "end": 3897.96,
      "text": "بہلہ تو آپ کا روٹ جو ہوگیا ہوں"
    },
    {
      "id": 140,
      "start": 3898.16,
      "end": 3899.16,
      "text": "دوسرا آپ نے کوئے لیے لوگہ"
    },
    {
      "id": 141,
      "start": 3899.36,
      "end": 3900.16,
      "text": "لیلے لو لیس کے انڈرایا ہوا"
    },
    {
      "id": 142,
      "start": 3900.36,
      "end": 3901.36,
      "text": "پھر آپ کیا کروگی"
    }
  ]
}