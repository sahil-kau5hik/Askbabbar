      "text": "ھاں سپوٹھا بلے بلہ کر آپ کوئی بھی داؤٹھتے ایک سے 2 hr."
    },
    {
      "id": 39,
      "start": 211.46,
      "end": 212.96,
      "text": "ھنٹے پر ازال کر دیا جائے گا کھوشی جو بنائیں جاتے ہیں"
    },
    {
      "id": 40,
      "start": 213.06,
      "end": 214.86,
      "text": "بہت ویلس فکچے دویوں بنائے جاتیں"
    },
    {
      "id": 41,
      "start": 214.96,
      "end": 217.36,
      "text": "کیا کر آپ مہنے دالیںگیں تو آپ کو ریزا اٹھ دیفرٹے ملے والا ہے"
    },
    {
      "id": 42,
      "start": 217.46,
      "end": 218.76,
      "text": "کوش بنانے والے بندیں"
    },
    {
      "id": 43,
      "start": 218.86,
      "end": 220.66,
      "text": "اورڈی بڑی بھڑھی کمپریام فورٹ چکے ہیں"
    },
    {
      "id": 44,
      "start": 220.76,
      "end": 222.16,
      "text": "تو اس کے آپ کو تنشل لنگی نہیں ہے"
    },
    {
      "id": 45,
      "start": 222.26,
      "end": 223.26,
      "text": "لانگوش کیا کہا بات کریں"
    },
    {
      "id": 46,
      "start": 223.36,
      "end": 224.96,
      "text": "ہندی انگلش دونوں میں بلیبل ہے"
    },
    {
      "id": 47,
      "start": 224.96,
      "end": 226.96,
      "text": "ھاکھا ھوشن سوال کرتے ہیں آپ کو حنتی بھیڈیوز میں جائیں گے"
    },
    {
      "id": 48,
      "start": 226.96,
      "end": 228.96,
      "text": "تو اگر آپ کو کوئی بیڈ کڑھ خریدنا ہے"
    },
    {
      "id": 49,
      "start": 229.96,
      "end": 232.96,
      "text": "تو اب آپ سمجھ دار ہے آپ کے پاس یہ لینکڑ اس کفشن میں پڑا ہوئے"
    },
    {
      "id": 50,
      "start": 233.96,
      "end": 235.96,
      "text": "اس پیڑ کر کیا آپ لیسکتے اور 20% اس کم جو کے میکسیم ہے"
    },
    {
      "id": 51,
      "start": 236.96,
      "end": 238.24,
      "text": "واکھوں میں جیگے گا"
