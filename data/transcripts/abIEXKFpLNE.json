      "id": 51,
      "start": 426.43,
      "end": 428.43,
      "text": "میں نے سنو کا مجھے بات آپ کو پیڈنٹ کا ہے کہاں سے پہدا ہوگo"
    },
    {
      "id": 52,
      "start": 428.43,
      "end": 432.25,
      "text": "کیا ہمیں پتا ہے تو ہم نے اب تک کیا کر لیا ہم سوش نور پے تھے"
    },
    {
      "id": 53,
      "start": 432.27,
      "end": 434.31,
      "text": "ہم 네 سوچ نور کو پش کر دیا ہوں نے اس کا ویشل"
    },
    {
      "id": 54,
      "start": 434.33,
      "end": 435.73,
      "text": "مارک کر دییا اور اس کا پیٹنٹ بھی سٹ کر دے"
    },
    {
      "id": 55,
      "start": 435.75,
      "end": 437.41,
      "text": "ایتنا شٹر کر دھی ہم نور اب ہم"
    },
    {
      "id": 56,
      "start": 437.43,
      "end": 439.23,
      "text": "اب ہون نے جاگا کیا رئے ایسا کرو"
    },
    {
      "id": 57,
      "start": 439.25,
      "end": 440.21,
      "text": "فرنت نور نہیں گالا"
