    },
    {
      "id": 1,
      "start": 529.52,
      "end": 531.52,
      "text": "ھو گرشی بھا گرچی ہے"
    },
    {
      "id": 2,
      "start": 534.06,
      "end": 535.06,
      "text": "ھا جانتے ہیں"
    },
    {
      "id": 3,
      "start": 536.06,
      "end": 538.06,
      "text": "ھنے ہیں"
    },
    {
      "id": 4,
      "start": 540.06,
      "end": 542.06,
      "text": "ھیں گے گرٹی ہے"
    },
    {
      "id": 5,
      "start": 544.06,
      "end": 547.7,
      "text": "ھتے ہے"
    },
    {
      "id": 6,
      "start": 556.54,
      "end": 561.81,
      "text": "ھہو گری کرتے"
    },
    {
      "id": 7,
      "start": 564.13,
      "end": 566.22,
      "text": "ھے گری چیگے"
    },
    {
      "id": 8,
      "start": 572.61,
      "end": 574.61,
      "text": "ھئے گارٹی گرگی"
    },
    {
      "id": 9,
      "start": 670.51,
      "end": 672.51,
      "text": "ھاکتی بیسی پہ آئی ہے اور سیپے ہی جی ہے۔"
    },
    {
      "id": 10,
      "start": 674.51,
      "end": 676.51,
      "text": "ھوپنے آپ سے ہی صویب ہو گیا۔"
    },
    {
      "id": 11,
      "start": 678.51,
      "end": 683.51,
      "text": "ھم نے کہاں لیکھا ایڈی دیس بیئے کاما آیا گیا 3 جا گیا 1"
    },
    {
      "id": 12,
      "start": 684.61,
      "end": 685.61,
      "text": "یہاں پہ بییس کے سری چھو گیاں"
    },
    {
      "id": 13,
      "start": 687.44,
      "end": 690.44,
      "text": "یہاً بیاس کے سی چھا اور بی اس کے سمی کیلے کا ریٹان کر جا وپس"
    },
    {
      "id": 14,
      "start": 691.44,
      "end": 694.5,
      "text": "باپس آگے"
    },
    {
      "id": 15,
      "start": 761.0,
      "end": 763.0,
      "text": "ھاں میں اس کوڑ کو رپٹیمائے سکتے تھاں"
    },
    {
      "id": 16,
      "start": 764.0,
      "end": 766.0,
      "text": "ھیں میں نے آپ میں 2 بونٹر لئے ہیں"
    },
    {
      "id": 17,
      "start": 767.0,
      "end": 769.67,
      "text": "ھےں میں سے اسے سنگل پانٹر سے کر سکھتے"
    },
    {
      "id": 18,
      "start": 770.67,
      "end": 772.67,
      "text": "ھیاں میں آپ کے لئیں ہوں وہ کیسکلے"
    },
    {
      "id": 19,
      "start": 773.86,
      "end": 774.86,
      "text": "ھئے آپ کو ایک ہندے رہوں"
    },
    {
      "id": 20,
      "start": 775.86,
      "end": 777.86,
      "text": "اس ہند کا آپ اسکتا ہے کہ آپ کو باست کر لوگ آپ کو ہند نہیں چے گے"
    },
    {
      "id": 21,
      "start": 778.86,
      "end": 779.86,
      "text": "یا آپ کو 10 سکنے آگے بڑھنا"
    },
    {
      "id": 22,
      "start": 780.86,
      "end": 781.86,
      "text": "تو ہند یہ ہے"
    },
    {
      "id": 23,
      "start": 782.9,
      "end": 783.9,
      "text": "آگ کو ہی ریوز کر لوں"
    },
    {
      "id": 24,
      "start": 784.9,
      "end": 785.9,
      "text": "سکیں پانچر بنانگلے ایک طریق ہے"
    },
    {
      "id": 25,
      "start": 786.9,
      "end": 787.9,
      "text": "کچھ اس پرکار کی چیز سوچھ نہ"
    },
    {
      "id": 26,
      "start": 1204.73,
      "end": 1206.73,
      "text": "ھا آپ کے لئے اس کوشن میں ہی تیار ہے"
    },
    {
      "id": 27,
      "start": 1208.56,
      "end": 1210.56,
      "text": "اب سلت انگلے کوشند پیار"
    },
    {
      "id": 28,
      "start": 1211.56,
      "end": 1212.56,
      "text": "جہاں میں آپ کا بولتانکہ کہاں نے آپ کو ایک کار کوشنت کریا تھا"
    },
    {
      "id": 29,
      "start": 1213.56,
      "end": 1214.56,
      "text": "پر آنے کو لیکچرس کے اندر"
    },
    {
      "id": 30,
      "start": 1215.56,
      "end": 1216.56,
      "text": "جہے میں آپ کو بولا گیاں آپ کے پاسنا"
    },
    {
      "id": 31,
      "start": 1217.56,
      "end": 1220.46,
      "text": "ایک انپوتوں میں A ہوگا"
    },
    {
      "id": 32,
      "start": 1221.46,
      "end": 1223.46,
      "text": "ایک value آپ نے لیلی user سے"
    },
    {
      "id": 33,
      "start": 1224.46,
      "end": 1226.46,
      "text": "کچھ بھی ہوگئا"
    },
    {
      "id": 34,
      "start": 1227.46,
      "end": 1229.46,
      "text": "آپ کو output میں کیا دینا ہے"
