      "id": 56,
      "start": 2112.08,
      "end": 2115.08,
      "text": "ھای پلسپرس و نحن میں نے پر انتکر دیوالیوز"
    },
    {
      "id": 57,
      "start": 2122.8,
      "end": 2123.8,
      "text": "ھے کیا؟"
    },
    {
      "id": 58,
      "start": 2124.8,
      "end": 2130.62,
      "text": "ھیں نے بلس کو چلاکہ دیکھا ہوئے گور"
    },
    {
      "id": 59,
      "start": 2131.62,
      "end": 2133.62,
      "text": "ھیک کا بھی اگر اندر سے بھی آنڈر لگا دیتے ہیں"
    },
    {
      "id": 60,
      "start": 2134.62,
      "end": 2135.62,
      "text": "ھتاک در ساپ سترا ہو دیا ہے"
    },
    {
      "id": 61,
      "start": 2137.9,
      "end": 2140.9,
      "text": "ھئے، سب سے بھالے آپ کے بانیی سوچ کی کال میں یہ والائرے پاس ہوا"
    },
