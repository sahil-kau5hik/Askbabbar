    {
      "id": 185,
      "start": 2960.72,
      "end": 2961.72,
      "text": "اس کے لابا ایک باکے ساری روز بچی ہوئی ہے"
    },
    {
      "id": 186,
      "start": 2962.72,
      "end": 2963.72,
      "text": "تو باكی سارھی رواز کے لئے آپ نے 2-4 روڑ بلا گا دیا"
