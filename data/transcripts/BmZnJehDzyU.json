    },
    {
      "id": 190,
      "start": 4202.45,
      "end": 4204.45,
      "text": "تو یعنی و رژڈڈن پیر"
    },
    {
      "id": 191,
      "start": 4205.45,
      "end": 4208.45,
      "text": "یعني وہ جو بیکٹ کا پیرت تھا"
    },
    {
      "id": 192,
      "start": 4209.45,
      "end": 4211.58,
      "text": "یہ والا اور یہ والа"
    },
    {
      "id": 193,
