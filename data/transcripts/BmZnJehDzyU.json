    {
      "id": 135,
      "start": 3245.24,
      "end": 3250.24,
      "text": "اسپیسکوم لیکشٹنی آپ کے لئے ہمکہ اس کری گرجی فرمشن کارسک بنائیں گے سوچنی کیا اسپینز لگر ہے"
    },
    {
      "id": 136,
      "start": 3251.24,
      "end": 3254.24,
      "text": "اسی کا دھانڈ رہے کہ ہمیں آپ اس کو بائے رفرنس پاس کر رہیں گلتی رہاں کریں اسپیکسکام لیکن لیکچنک آل لیکر"
    },
    {
      "id": 137,
      "start": 3255.27,
      "end": 3258.27,
      "text": "آگے بڑھتے ہیں ہمارے اگلے کشن کے تاب جو کی ہے"
    },
    {
      "id": 138,
      "start": 3259.27,
      "end": 3263.27,
      "text": "ریدنڈڈنڇ براکٹس تو بعد کرتے نیکشکشن کی بارے میں اس کا نام ہے ریداڈ دنڒڈھنڣڈس"
    },
    {
      "id": 139,
      "start": 3263.27,
      "end": 3266.69,
      "text": "سمجھتے ہیں اس کو کیا کہتا ہے یہ کاشر یہ ریستہ کیا کر لاتا ہے"
    },
    {
      "id": 140,
      "start": 3266.77,
      "end": 3269.87,
      "text": "یہ کہتار کی میثمدیکٹسپریشن آپ کو دیاں کا اشپرین کی فام میں"
    },
    {
      "id": 141,
      "start": 3269.97,
      "end": 3271.27,
      "text": "آپ کو بتانا ہے"
    },
    {
      "id": 142,
      "start": 3271.57,
      "end": 3273.27,
      "text": "آپ کو ریٹرن ٹروک کرنا ہے"
    },
    {
      "id": 143,
      "start": 3273.37,
      "end": 3273.97,
      "text": "اگر"
    },
    {
      "id": 144,
      "start": 3274.07,
      "end": 3276.17,
      "text": "اکسپریشن کے اندر ریڈرنژرن بکٹس ہوں"
    },
    {
      "id": 145,
      "start": 3276.27,
      "end": 3277.67,
      "text": "نہیں تو فوقت سے دے نا بھی"
    },
    {
      "id": 146,
      "start": 3278.3,
      "end": 3280.8,
      "text": "ایک بیچ 스톱 کے انדר یہ براکٹر سوٹھیں ہیں"
    },
    {
      "id": 147,
      "start": 3280.9,
      "end": 3283.6,
      "text": "وری سارے عبرٹر حوصکتے اور لوور کچھ انگلیش کے لٹر ہوصیکتے"
    },
