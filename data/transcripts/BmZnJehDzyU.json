      "end": 4224.22,
      "text": "وہ جوب بیککٹ ہے"
    },
    {
      "id": 197,
      "start": 4225.22,
      "end": 4227.22,
      "text": "وہ جود بیکپٹ ہے"
    },
    {
      "id": 198,
      "start": 4350.13,
      "end": 4360.13,
      "text": "तभूताक में से पाँर्ट करतिरो जद तोमैी हो परने नहीं फावाड़ा."
    },
    {
      "id": 199,
      "start": 4787.5,
      "end": 4790.38,
      "text": "ھاں ھوڑڑ ھکلوڈ ھے ہیں"
    },
    {
      "id": 200,
      "start": 4790.54,
      "end": 4794.28,
      "text": "ھہوں کے بعد آپ کے اپنوالیا گئے"
    },
    {
      "id": 201,
      "start": 4794.3,
      "end": 4796.3,
      "text": "تین پیٹنس ہے"
    },
    {
      "id": 202,
      "start": 4796.32,
      "end": 4797.66,
      "text": "یہ تین بیٹنتس ہیں"
    },
    {
      "id": 203,
      "start": 4797.68,
      "end": 4799.2,
      "text": "جو کی ان ملد STRINGS میں آئیں گے"
    },
    {
      "id": 204,
      "start": 4799.22,
      "end": 4801.02,
      "text": "باکہ ساری چیزیں آپ کی ویلڈ ہوگی"
    },
    {
      "id": 205,
      "start": 4801.59,
      "end": 4804.21,
      "text": "سمجھ میں اس کا لہا با کچھ بے گوڋ تو ویڈ ہی ہوگا"
    },
    {
      "id": 206,
      "start": 4804.5,
      "end": 4805.96,
