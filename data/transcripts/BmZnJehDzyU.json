    },
    {
      "id": 180,
      "start": 3652.42,
      "end": 3653.42,
      "text": "اس کے قصمی رہٹر نہیں ہے"
    },
    {
      "id": 181,
      "start": 3654.42,
      "end": 3655.42,
      "text": "و رنوں کے قیس میں"
    },
    {
      "id": 182,
      "start": 3656.42,
      "end": 3658.42,
      "text": "اگر ما لو стایک کرنہ سے فوپریگ بیکٹ پڑا ہوتا"
    },
    {
      "id": 183,
      "start": 3659.42,
      "end": 3660.42,
      "text": "آپ کا بھی کلوزیں بیگٹ آیا"
    },
    {
      "id": 184,
      "start": 3661.42,
      "end": 3662.42,
      "text": "آپ نے TOP چیک کیا"
    },
    {
      "id": 185,
      "start": 3663.42,
