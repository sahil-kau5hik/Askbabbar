      "end": 4214.58,
      "text": "اگر not found"
    },
    {
      "id": 194,
      "start": 4215.58,
      "end": 4217.67,
      "text": "کوئے опри터 ہیں نہیں ان کے بیچ میں"
    },
    {
      "id": 195,
      "start": 4218.67,
      "end": 4221.22,
      "text": "تو بھائی our redundant prayer"
    },
    {
      "id": 196,
