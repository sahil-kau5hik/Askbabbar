      "start": 2604.05,
      "end": 2605.05,
      "text": "اپنے اسوالتہ میں نور بنالی"
    },
    {
      "id": 3,
      "start": 2606.05,
      "end": 2607.05,
      "text": "نور ان اٹار تم فجیکوز ٹو"
    },
    {
      "id": 4,
      "start": 2608.05,
      "end": 2610.88,
      "text": "جو بھی آپ کے مینی ہیت کے طوپ میں پڑا ہوئے"
    },
    {
      "id": 5,
      "start": 2611.88,
      "end": 2616.22,
      "text": "نکالی اس کو پاپ کر دیا"
    },
    {
      "id": 6,
      "start": 2617.22,
      "end": 2619.82,
      "text": "اب آگے بڑھتے ہیں"
    },
    {
      "id": 7,
      "start": 2620.82,
      "end": 2621.82,
      "text": "اب آ گے بھڑتے ہیں"
    },
    {
      "id": 8,
      "start": 2622.82,
      "end": 2625.98,
      "text": "ہم نے کہاں ہوں سے کہ آپ کا حد جہاں بنال ہو"
    },
    {
      "id": 9,
      "start": 2626.98,
      "end": 2628.98,
      "text": "اگر آپ کا الحدنال ہے تو پہلے اس سے مجھ پڈا ہے"
    },
    {
      "id": 10,
      "start": 2629.98,
      "end": 2632.83,
      "text": "اچھے حد تو قید کریں تو پھر حد کر لے"
    },
    {
      "id": 11,
      "start": 2635.34,
      "end": 2636.34,
      "text": "یہ بنائی حد"
    },
    {
      "id": 12,
      "start": 2972.4,
      "end": 2974.4,
      "text": "اپنے میں اس کا دورن کو سوڑھے جسکتے ہیں"
    },
    {
      "id": 13,
      "start": 2975.4,
      "end": 2976.4,
      "text": "اپتیمانستہ کو بتا ہی دیئیں"
    },
    {
      "id": 14,
      "start": 2977.4,
      "end": 2978.4,
      "text": "انٹرمیہ آپ فاصوگی نہیں آپ بتا دو گے"
    },
    {
      "id": 15,
      "start": 2979.4,
      "end": 2981.4,
      "text": "بات حالی میں اس کے لئے میں اول سکتا ہوں کہ میں ایک اپروچھور دیکھ کر لی"
    },
    {
      "id": 16,
      "start": 2982.46,
      "end": 2983.46,
      "text": "یہ آپ کا سکھتے ہے"
    },
    {
      "id": 17,
      "start": 2984.46,
      "end": 2985.46,
      "text": "ہر کوشن کو دورٹرارن کرنا ہے"
    },
    {
      "id": 18,
      "start": 2986.46,
      "end": 2987.46,
      "text": "ہر کھولڈ کرنا تو اب ذاکھ اور قیرٹی ملٹے ہیں"
    },
    {
      "id": 19,
      "start": 2988.46,
      "end": 2989.46,
      "text": "اپس میں کمانشہ سے پتاکہ جانا ہے"
    },
    {
      "id": 20,
      "start": 2990.46,
      "end": 2991.46,
      "text": "ملطا ہمیں تھوڈی شدewa"
    },
    {
      "id": 21,
      "start": 2992.46,
      "end": 2993.46,
      "text": "اکل اگلی ویڈو کی ساتھ"
    },
    {
      "id": 22,
      "start": 2993.46,
      "end": 2999.56,
      "text": "او او بیپس کچھ ہاد کچن ہے جا پو کرائے جائیں گے آپ کو مجھے آئیں گیں تو اوی حرمتنگ ملتنکتو میں تبتق لیے"
    }
  ]
