      "end": 4555.9,
      "text": "ہر کسی کی بویشن در پلیس ہو ری ہے"
    },
    {
      "id": 152,
      "start": 4556.0,
      "end": 4557.9,
      "text": "جو یہاں فرستا وہ یہاہ دا کے فرس بن گیا"
