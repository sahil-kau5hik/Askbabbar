      "text": "ایசے نہیں کر نہ ہوتa"
    },
    {
      "id": 128,
      "start": 2739.42,
      "end": 2741.62,
      "text": "اگر امکڑ رکτس کے بعد کریں اس کے کم پیریزن میں"
    },
    {
      "id": 129,
      "start": 2741.92,
      "end": 2743.02,
      "text": "تو بھی آگر میں جادہ"
