    {
      "id": 131,
      "start": 2744.22,
      "end": 2745.32,
      "text": "مگربان و ایسم ناثون"
    },
    {
      "id": 132,
      "start": 3631.12,
      "end": 3639.12,
      "text": "پہلے والے کا ADDRESS دیدیا وہ کہاںストور ہو گیاں میں نے آپ علیکہ کہ انت ARR یہ تو اس ARR کے اندرストور ہوں گیا"
    },
    {
      "id": 133,
      "start": 3640.89,
      "end": 3647.97,
      "text": "اگر اب اس ARNAB کوئی بھی προسیسن کر ہو گئے کی سبھی پرکار کی میک کچھ آژ کرتا ہوں میں کچhrی موگ کرتتا"
    },
    {
      "id": 134,
      "start": 3648.89,
      "end": 3653.89,
      "text": "اگری کچھی اپنا دیٹ کرتے ہیں تو وہ آپ Actual Array پر ہی کر رہی ہو جو کی ہاں پانا پڑھا ہے"
    },
    {
      "id": 135,
      "start": 4375.94,
      "end": 4378.94,
      "text": "بائنے ریسرش کا کیا بات ہے پڑا ہی پیارہ پژا موتا ہے"
    },
    {
      "id": 136,
      "start": 4379.94,
      "end": 4380.94,
      "text": "بائینی سرش"
    },
    {
      "id": 137,
      "start": 4381.94,
      "end": 4384.94,
      "text": "انترریوز میں آر لین کوٹنگ ٹیشٹ میں کمپنی کے اسسمنٹ میں"
    },
    {
      "id": 138,
      "start": 4385.94,
      "end": 4387.94,
      "text": "ویس آپ یہ والی کشن پوچھا چاہا ہاتھا ہوتے ہیں"
    },
    {
      "id": 139,
      "start": 4388.94,
      "end": 4389.94,
      "text": "بائνے رہی سریش پڈے ہیں"
    },
    {
      "id": 140,
