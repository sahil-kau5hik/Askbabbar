    {
      "id": 12,
      "start": 520.7,
      "end": 528.7,
      "text": "ھا اگر اسپیس کم بیس کرنے آپ کو سالو کرنہا ہے"
    },
    {
      "id": 13,
      "start": 529.7,
      "end": 531.7,
      "text": "اگری بل لیلو بہ اس کے دورای سال و کرنیں والے والے"
    },
    {
      "id": 14,
      "start": 532.7,
      "end": 534.7,
      "text": "کوئی دیٹسے سے جوزن کرنیا گا ہے"
    },
    {
      "id": 15,
      "start": 535.7,
      "end": 537.7,
      "text": "تو اگی بل کے دارا میں اس کو سولو کرنا ہے"
    },
    {
      "id": 16,
      "start": 538.7,
      "end": 541.7,
      "text": "تو بعد کریں گے اپروش ٹو کی بارے میں"
    },
    {
      "id": 17,
      "start": 542.7,
      "end": 543.7,
      "text": "فردہ بٹ سبوستے اس کو"
    },
    {
      "id": 18,
      "start": 1572.68,
      "end": 1574.68,
      "text": "ھاکٹانس را گیا بہت بڑیا"
    },
    {
      "id": 19,
      "start": 1574.98,
      "end": 1576.78,
      "text": "اب اس کو ایک ورفن اپنا بٹ سمید کر کر دیکھلے"
    },
    {
      "id": 20,
      "start": 1577.98,
      "end": 1579.08,
      "text": "سمیند کر دیگلے"
    },
    {
      "id": 21,
      "start": 1579.98,
      "end": 1581.18,
      "text": "کر ایک ٹانس الرا گئی بہا بڈیا"
    },
    {
      "id": 22,
      "start": 1581.58,
      "end": 1582.88,
      "text": "تو اس پہ کارم نے قوڑ لکلیا"
    },
    {
      "id": 23,
      "start": 1582.98,
      "end": 1584.88,
      "text": "جانس دوبارے کو دیکھی اس کو تم نے ایک стاک بن آیا تھا"
    },
    {
      "id": 24,
      "start": 1584.98,
      "end": 1586.48,
      "text": "دیٹیام برش کر دو ایک مینی وری بلی رکھا"
    },
    {
      "id": 25,
      "start": 1586.58,
      "end": 1587.08,
      "text": "منا دیکیا"
    },
    {
      "id": 26,
      "start": 1587.28,
      "end": 1589.28,
      "text": "بہی آپ اپنے میں نہیں کو انٹمیکس کرنے کو بولا تھا"
    },
    {
      "id": 27,
      "start": 1589.38,
      "end": 1590.48,
      "text": "میں نے بولہ بلکوٹ بات ہے"
    },
    {
      "id": 28,
      "start": 1590.78,
      "end": 1592.08,
      "text": "کرنا چا ہو کر سکتیو"
    }
  ]
