# ==========================================
# Love Babbar DSA C++ Video RAG Configuration
# ==========================================

# Playlist Configuration
PLAYLIST_URL=https://www.youtube.com/playlist?list=PLDzeHZWIZsTryvtXdMr6rPh4IDexB5NIA
DATA_DIR=data

# Ingestion Settings
CHUNK_SIZE_SECONDS=60
CHUNK_OVERLAP_SECONDS=0

# Speech-to-Text (STT) Settings
# Options: "faster-whisper", "groq", "openai"
STT_PROVIDER=faster-whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
GROQ_API_KEY=

# Embedding Model Settings
# Options: "sentence-transformers/all-MiniLM-L6-v2", "BAAI/bge-small-en-v1.5", "intfloat/multilingual-e5-small"
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Qdrant Vector Database
# Leave QDRANT_URL empty to use local embedded disk storage at ./data/qdrant_db
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=love_babbar_dsa

# LLM Generation
# Providers: "gemini", "openai", "groq", "ollama"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your_gemini_api_key_here

# Retrieval Settings
TOP_K=5
SIMILARITY_THRESHOLD=0.35
EXPAND_ADJACENT_CHUNKS=true

# API Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
